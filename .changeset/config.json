{
	"$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
	"baseBranch": "main",
	"access": "public",
	"format": "auto",
	"changelog": "@changesets/cli/changelog",
	"commit": false,
	"fixed": [
		[
			"@edmi/tokens",
			"@edmi/registry-react",
			"@edmi/registry-vue",
			"@edmi/registry-svelte"
		]
	],
	"linked": [],
	"ignore": [
		"@edmi/react",
		"@edmi/vue",
		"@edmi/svelte",
		"@edmi/docs",
		"@edmi/example-react",
		"@edmi/example-vue",
		"@edmi/example-svelte"
	],
	"updateInternalDependencies": "patch"
}

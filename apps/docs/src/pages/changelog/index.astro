---
// Changelog: standalone page, no sidebar (splash template), narrow reading column.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Changelog from "../../components/Changelog.astro";
---

<StarlightPage
	frontmatter={{
		title: "Changelog",
		description: "Release notes, generated by Changesets.",
		template: "splash",
		tableOfContents: false,
	}}
>
	<div class="edmi-wide edmi-changelog">
		<div class="edmi-page-title">
			<div class="edmi-page-h">Changelog</div>
			<p class="edmi-page-desc">Release notes, generated by Changesets.</p>
		</div>
		<Changelog />
	</div>
</StarlightPage>

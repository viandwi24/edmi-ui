---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { badgeVariants } from "@edmi-react/ui/badge";
import { buttonVariants } from "@edmi-react/ui/button";
import { BASE } from "../config";
import {
	ChartCard,
	ChatCard,
	CommandCard,
	ControlsCard,
	FeedbackCard,
	FormCard,
	LandingFooter,
	MarketCard,
	PeopleCard,
	QuestionCard,
} from "../components/landing/cards";
import { AiPackCard, InstallCard, LiveBar, ThemeScopes } from "../components/landing/sections";

const p = (s: string) => `${BASE}${s}`;
const why = [
	{
		n: "01",
		title: "shadcn anatomy, Edmi voice.",
		text: "Same item names, props and data-slots as the shadcn ports, so the CLI you already use just works. Edmi additions are marked with a star.",
	},
	{
		n: "02",
		title: "Flat by default, raised when you want.",
		text: "Every component is a quiet 1px-border control. Add raised for one step of 3D: a gradient, a highlight and a single hard lip. No blurred shadows, light or dark.",
	},
	{
		n: "03",
		title: "Three frameworks, one set of tokens.",
		text: "Base UI for React, Reka UI for Vue and Bits UI for Svelte, all reading the same OKLCH tokens. Copy it in and own it.",
	},
];
---

<StarlightPage
	frontmatter={{
		title: "Edmi UI",
		description:
			"Editorial-minimalist shadcn-compatible registry for React, Vue and Svelte. Flat by default, one-step 3D when you want it.",
		template: "splash",
		tableOfContents: false,
	}}
>
	<div class="edmi-landing not-content relative overflow-x-clip pb-4 text-foreground-2">
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-x-0 top-0 h-[700px] bg-[radial-gradient(var(--grid-dot)_1px,transparent_1px)] bg-[size:18px_18px] [mask-image:linear-gradient(black,transparent)]"
		>
		</div>

		<section class="relative px-4 pt-14 pb-10 text-center sm:pt-[88px] sm:pb-14">
			<a
				class={`${badgeVariants({ variant: "brand", shape: "pill" })} h-7 gap-2 px-3 text-[12.5px] no-underline`}
				href={p("/components/ai-chat/ai-message/")}
			>
				<span class="size-[7px] rounded-full bg-current"></span>
				New: Edmi AI pack · 50+ AI components
				<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
			</a>
			<h1 class="mx-auto mt-6 max-w-[900px] text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.02] font-medium tracking-[-0.04em] text-balance text-ink-soft">
				Quiet, tactile components for the interfaces you ship
			</h1>
			<p class="mx-auto mt-5 max-w-[600px] text-[clamp(1rem,1.6vw,1.125rem)] leading-[1.55] text-muted-foreground">
				An editorial-minimal, shadcn-compatible registry for React, Vue and Svelte. Flat by default,
				one-step 3D when you want it, and code you copy in and own.
			</p>
			<div class="mt-[30px] flex flex-wrap justify-center gap-2.5">
				<a class={`${buttonVariants({ size: "lg", raised: true })} no-underline`} href={p("/getting-started/react/")}>
					Get started
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</a>
				<a class={`${buttonVariants({ size: "lg", variant: "secondary", raised: true })} no-underline`} href={p("/components/actions/button/")}>Browse components</a>
			</div>
			<div class="mx-auto mt-9 w-[min(32.5rem,100%)]">
				<InstallCard client:load />
			</div>
			<p class="mt-3 text-[13px] text-muted-foreground">
				Using Vue or Svelte? Pick it in the header.{" "}
				<a class="text-foreground underline underline-offset-[3px]" href={p("/getting-started/react/#install-everything")}>Install everything →</a>
			</p>
		</section>

		<div id="edmi-live" data-base="stone" data-theme="green" class="relative bg-background px-4 pb-4 text-foreground sm:px-6">
			<div class="mx-auto mb-4 flex max-w-[1280px] flex-wrap items-center justify-between gap-4 border-t border-border pt-[22px]">
				<div>
					<div class="text-[15px] font-medium">Live preview</div>
					<div class="mt-0.5 text-[12.5px] text-muted-foreground">Real components from the registry. Switch the style and theme.</div>
				</div>
				<LiveBar client:load />
			</div>
			<section class="mx-auto grid max-w-[1280px] grid-cols-1 items-start gap-5 sm:grid-cols-2 xl:grid-cols-4" aria-label="Component showcase">
				<div class="flex min-w-0 flex-col gap-5">
					<ControlsCard client:visible />
					<ChartCard client:visible />
				</div>
				<div class="flex min-w-0 flex-col gap-5">
					<FormCard client:visible />
					<ChatCard client:visible />
				</div>
				<div class="flex min-w-0 flex-col gap-5">
					<CommandCard client:visible />
					<MarketCard client:visible />
					<QuestionCard client:visible />
				</div>
				<div class="flex min-w-0 flex-col gap-5">
					<FeedbackCard client:visible />
					<PeopleCard client:visible />
				</div>
			</section>
		</div>

		<section class="relative mx-auto mt-16 max-w-[1040px] px-4 sm:mt-[110px]">
			<h2 class="m-0 text-[clamp(1.75rem,4vw,2.625rem)] leading-[1.1] font-medium tracking-[-0.035em] text-ink-soft">
				Built to be read, then owned <span class="text-muted-foreground">in three small decisions.</span>
			</h2>
			<div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-10">
				{why.map((w) => (
					<div>
						<div class="font-mono text-xs text-muted-foreground">{w.n}</div>
						<div class="mt-[22px] text-[19px] font-medium tracking-[-0.02em] text-ink-soft">{w.title}</div>
						<p class="m-0 mt-2.5 text-sm leading-[1.65] text-muted-foreground">{w.text}</p>
					</div>
				))}
			</div>
		</section>

		<section class="relative mx-auto mt-16 max-w-[1040px] px-4 sm:mt-[110px]">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<div class="font-mono text-xs tracking-wider text-muted-foreground">THEMING</div>
					<h2 class="m-0 mt-2.5 text-[clamp(1.5rem,3.4vw,2.125rem)] leading-[1.15] font-medium tracking-[-0.03em] text-ink-soft">Four knobs. Every component follows.</h2>
					<p class="m-0 mt-2.5 text-[15px] text-muted-foreground">Base color, theme, mode and radius — plain CSS variables on <code>&lt;html&gt;</code>.</p>
				</div>
				<a class={`${buttonVariants({ variant: "outline" })} no-underline`} href={p("/themes/")}>
					Open the theme playground
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</a>
			</div>
			<div class="mt-[26px]"><ThemeScopes client:visible /></div>
		</section>

		<section class="relative mx-auto mt-16 flex max-w-[1040px] flex-col gap-8 px-4 sm:mt-[110px] lg:flex-row lg:gap-7">
			<div class="lg:w-[380px] lg:shrink-0">
				<div class="font-mono text-xs text-muted-foreground">@edmi-ui/ai</div>
				<h2 class="m-0 mt-2.5 text-[clamp(1.5rem,3.4vw,2.125rem)] leading-[1.15] font-medium tracking-[-0.03em] text-ink-soft">Chat, agents and tools — same voice.</h2>
				<p class="m-0 mt-3 text-[15px] leading-[1.6] text-muted-foreground">
					Every AI Elements component, restyled with Edmi tokens, plus artifacts, session panels and agent avatars. It lives in components/ai and never leaks into the core kit.
				</p>
				<a class={`${buttonVariants({ variant: "secondary", raised: true })} mt-5 no-underline`} href={p("/components/ai-chat/ai-message/")}>
					Explore the AI pack
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
				</a>
			</div>
			<div class="min-w-0 flex-1"><AiPackCard client:visible /></div>
		</section>

		<div class="relative mx-auto mt-16 mb-10 max-w-[1040px] px-4 sm:mt-[110px] [&_a]:text-foreground-2 [&_a]:no-underline [&_a:hover]:text-foreground"><LandingFooter /></div>
	</div>
	<script is:inline>
		// Dark tokens for data-base/data-theme scopes are `.dark[data-base]`, so the live wrapper mirrors html.dark.
		(function () {
			var root = document.documentElement;
			var el = document.getElementById("edmi-live");
			function sync() {
				if (el) el.classList.toggle("dark", root.classList.contains("dark"));
			}
			sync();
			new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["class"] });
		})();
	</script>
</StarlightPage>

<style is:global>
	/* full-bleed landing inside Starlight's splash frame */
	html[data-theme]:has(.edmi-landing) { --sl-content-width: 96rem; }
	html:has(.edmi-landing) .content-panel { padding: 0; }
	html:has(.edmi-landing) main { padding: 0; }
	html:has(.edmi-landing) .sl-markdown-content { font-size: inherit; }
	html:has(.edmi-landing) .sl-container > * + * { margin-top: 0; }
	html:has(.edmi-landing) footer.sl-flex,
	html:has(.edmi-landing) .content-panel > .sl-container > footer { display: none; }
	.edmi-landing astro-island { display: block; }
</style>

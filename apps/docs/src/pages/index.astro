---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { buttonVariants } from "@edmi-react/ui/button";
import { BASE } from "../config";
import InstallTabs from "../components/landing/InstallTabs.astro";
import {
	ChartCard,
	ChatCard,
	CommandCard,
	ControlsCard,
	FeedbackCard,
	FormCard,
	LandingFooter,
	MarketCard,
	PeopleCard,
	QuestionCard,
	RaisedToggle,
} from "../components/landing/cards";

const p = (s: string) => `${BASE}${s}`;
const why = [
	{
		n: "01",
		title: "shadcn anatomy, Edmi voice.",
		text: "Same item names, props and data-slots as the shadcn ports, so the CLI you already use just works. Edmi additions are marked with a star.",
	},
	{
		n: "02",
		title: "Flat by default, raised when you want.",
		text: "Every component is a quiet 1px-border control. Add the raised prop for one step of 3D: a gradient, a highlight and a single hard lip. Nothing uses a blurred shadow, in light or dark.",
	},
	{
		n: "03",
		title: "Three frameworks, one set of tokens.",
		text: "Base UI for React, Reka UI for Vue and Bits UI for Svelte, all reading the same OKLCH tokens. Copy it in and own it.",
	},
];
---

<StarlightPage
	frontmatter={{
		title: "Edmi UI",
		description:
			"Editorial-minimalist shadcn-compatible registry for React, Vue and Svelte. Flat by default, one-step 3D when you want it.",
		template: "splash",
		tableOfContents: false,
	}}
>
	<div class="edmi-landing not-content">
		<section class="edmi-hero">
			<a class="edmi-pill" href={p("/components/conversation/questionnaire/")}>
				<span class="edmi-pill-dot"></span>
				New Questionnaire component
				<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
			</a>
			<h1>Quiet, tactile components for the interfaces you ship</h1>
			<p class="edmi-lede">
				An editorial-minimalist, shadcn-compatible registry for React, Vue and Svelte. Flat by
				default, one-step 3D when you want it, and code you copy in and own.
			</p>
			<div class="edmi-cta">
				<a class={buttonVariants({ size: "lg", raised: true })} href={p("/getting-started/react/")}>Get started</a>
				<a class={buttonVariants({ size: "lg", variant: "outline", raised: true })} href={p("/components/actions/button/")}>Browse components</a>
			</div>
			<InstallTabs />
		</section>

		<div class="edmi-showcase-bar">
			<RaisedToggle client:load />
			<span class="edmi-showcase-hint">Same components, <code>raised</code> flips on.</span>
		</div>

		<section class="edmi-showcase" aria-label="Component showcase">
			<div class="edmi-cell"><ControlsCard client:visible /></div>
			<div class="edmi-cell"><ChartCard client:visible /></div>
			<div class="edmi-cell"><FormCard client:visible /></div>
			<div class="edmi-cell"><ChatCard client:visible /></div>
			<div class="edmi-cell"><CommandCard client:visible /></div>
			<div class="edmi-cell"><MarketCard client:visible /></div>
			<div class="edmi-cell"><QuestionCard client:visible /></div>
			<div class="edmi-cell"><FeedbackCard client:visible /></div>
			<div class="edmi-cell"><PeopleCard client:visible /></div>
		</section>

		<section class="edmi-why">
			<h2>Built to be read, then owned<span> in three small decisions.</span></h2>
			<div class="edmi-why-grid">
				{why.map((w) => (
					<div>
						<span class="edmi-why-n">{w.n}</span>
						<h3>{w.title}</h3>
						<p>{w.text}</p>
					</div>
				))}
			</div>
		</section>

		<div class="edmi-footer-wrap"><LandingFooter /></div>
	</div>
</StarlightPage>

<style is:global>
	/* full-bleed landing inside Starlight's splash frame */
	html[data-theme]:has(.edmi-landing) { --sl-content-width: 96rem; }
	html:has(.edmi-landing) .content-panel { padding: 0; }
	html:has(.edmi-landing) main { padding: 0; }
	html:has(.edmi-landing) .sl-markdown-content { font-size: inherit; }
	html:has(.edmi-landing) .sl-container > * + * { margin-top: 0; }
	html:has(.edmi-landing) footer.sl-flex,
	html:has(.edmi-landing) .content-panel > .sl-container > footer { display: none; }

	.edmi-landing {
		--gutter: clamp(1rem, 3vw, 2rem);
		padding-bottom: 2.5rem;
		color: var(--foreground-2);
	}
	.edmi-hero {
		display: flex; flex-direction: column; align-items: center; text-align: center;
		padding: clamp(3rem, 8vw, 6.5rem) var(--gutter) clamp(2.5rem, 6vw, 4.5rem);
		background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
		background-size: 18px 18px;
		-webkit-mask-image: none;
	}
	.edmi-pill {
		display: inline-flex; align-items: center; gap: .5rem; height: 28px; padding: 0 .75rem;
		border-radius: 999px; font-size: 12.5px; font-weight: 500; text-decoration: none;
		color: var(--brand-text); background: var(--brand-soft);
		border: 1px solid color-mix(in oklab, var(--brand) 35%, transparent);
	}
	.edmi-pill:hover { border-color: color-mix(in oklab, var(--brand) 60%, transparent); }
	.edmi-pill-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand); }
	.edmi-hero h1 {
		margin: 1.5rem 0 0; max-width: 17ch;
		font-size: clamp(2.5rem, 6.4vw, 4.75rem); font-weight: 500; line-height: 1.02;
		letter-spacing: -0.045em; color: var(--ink-soft); text-wrap: balance;
	}
	.edmi-lede {
		margin: 1.5rem 0 0; max-width: 40rem; font-size: clamp(1rem, 1.6vw, 1.1875rem);
		line-height: 1.55; color: var(--muted-foreground);
	}
	.edmi-cta { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 2rem; }
	.edmi-cta a { text-decoration: none; }

	.edmi-install { margin-top: 2.25rem; width: min(31rem, 100%); }
	.edmi-install-tabs {
		display: inline-flex; gap: 2px; padding: 3px; border-radius: 9px;
		background: var(--muted); border: 1px solid var(--border);
	}
	.edmi-install-tabs button {
		font: 500 12.5px/1 var(--sl-font); padding: .4rem .75rem; border-radius: 6px;
		border: 1px solid transparent; background: transparent; color: var(--muted-foreground); cursor: pointer;
	}
	.edmi-install-tabs button[aria-selected="true"] {
		background: var(--tab-active); border-color: var(--border); color: var(--foreground);
	}
	.edmi-install-cmd {
		margin-top: .625rem; display: flex; align-items: center; gap: .625rem; text-align: left;
		height: 44px; padding: 0 .5rem 0 .875rem; border-radius: 10px;
		background: var(--card); border: 1px solid var(--input);
		box-shadow: inset 0 1px 2px rgb(0 0 0 / .06);
		overflow: hidden;
	}
	.edmi-install-prompt { font-family: var(--sl-font-mono); color: var(--muted-foreground-2); font-size: 13px; }
	.edmi-install-cmd code {
		flex: 1; min-width: 0; font-family: var(--sl-font-mono); font-size: 12.5px; color: var(--foreground);
		white-space: nowrap; overflow-x: auto; scrollbar-width: none; background: none; border: 0; padding: 0;
	}
	.edmi-install-copy {
		display: grid; place-items: center; width: 30px; height: 30px; border-radius: 7px; border: 0;
		background: transparent; color: var(--muted-foreground); cursor: pointer; flex-shrink: 0;
	}
	.edmi-install-copy:hover { background: var(--accent); color: var(--foreground); }
	.edmi-install-copy[data-done] { color: var(--brand-text); }

	.edmi-showcase-bar {
		display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: .75rem;
		padding: 0 var(--gutter) 1.5rem;
	}
	.edmi-showcase-hint { font-size: 13px; color: var(--muted-foreground); }
	.edmi-showcase-hint code { font-size: 12px; }
	.edmi-showcase {
		column-count: 1; column-gap: 1rem; padding: 0 var(--gutter);
		max-width: 1700px; margin-inline: auto;
	}
	@media (min-width: 40rem) { .edmi-showcase { column-count: 2; } }
	@media (min-width: 66rem) { .edmi-showcase { column-count: 3; } }
	@media (min-width: 112rem) { .edmi-showcase { column-count: 4; } }
	.edmi-cell { break-inside: avoid; margin-bottom: 1rem; display: block; }
	.edmi-cell > astro-island { display: block; }

	.edmi-why { max-width: 1200px; margin: clamp(4rem, 9vw, 7rem) auto 0; padding: 0 var(--gutter); }
	.edmi-why h2 {
		margin: 0; font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 500;
		letter-spacing: -0.035em; line-height: 1.1; color: var(--ink-soft);
	}
	.edmi-why h2 span { color: var(--muted-foreground-2); }
	.edmi-why-grid { display: grid; gap: 2rem; margin-top: 2.75rem; grid-template-columns: 1fr; }
	@media (min-width: 52rem) { .edmi-why-grid { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
	.edmi-why-n { font-family: var(--sl-font-mono); font-size: 12px; color: var(--muted-foreground-2); }
	.edmi-why-grid h3 {
		margin: .875rem 0 0; font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; color: var(--ink-soft);
	}
	.edmi-why-grid p { margin: .625rem 0 0; font-size: .9375rem; line-height: 1.6; color: var(--muted-foreground); }

	.edmi-footer-wrap a { color: var(--foreground-2); text-decoration: none; }
	.edmi-footer-wrap a:hover { color: var(--foreground); }
	.edmi-footer-wrap { max-width: 1200px; margin: clamp(4rem, 8vw, 6rem) auto 0; padding: 0 var(--gutter); }
</style>

---
import Search from "@astrojs/starlight/components/Search.astro";
import { BASE } from "../../config";
import FrameworkSelect from "./FrameworkSelect.astro";
import SocialIcons from "./SocialIcons.astro";
import ThemeSelect from "./ThemeSelect.astro";

const path = Astro.url.pathname;
const p = (s: string) => `${BASE}${s}`;
const nav = [
	{ label: "Docs", href: p("/getting-started/react/"), match: "/getting-started" },
	{ label: "Components", href: p("/components/"), match: "/components/", not: "/components/patterns" },
	{ label: "Patterns", href: p("/components/patterns/stat-tile/"), match: "/components/patterns" },
	{ label: "Examples", href: p("/examples/"), match: "/examples" },
	{ label: "Theming", href: p("/theming/"), match: "/theming" },
	{ label: "Rules", href: p("/rules/"), match: "/rules" },
	{ label: "Changelog", href: p("/changelog/"), match: "/changelog" },
];
const isActive = (n: (typeof nav)[number]) =>
	path.startsWith(p(n.match)) && !(n.not && path.startsWith(p(n.not)));
---

<div class="edmi-header">
	<a class="edmi-brand" href={p("/")} aria-label="Edmi UI home">
		<span class="edmi-mark" aria-hidden="true">
			<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><rect x="2" y="9" width="2.6" height="5" rx="1"></rect><rect x="6.7" y="5" width="2.6" height="9" rx="1"></rect><rect x="11.4" y="2" width="2.6" height="12" rx="1"></rect></svg>
		</span>
		<span class="edmi-wordmark font-brand">edmi-ui</span>
	</a>
	<nav class="edmi-nav" aria-label="Main">
		{nav.map((n) => <a href={n.href} aria-current={isActive(n) ? "page" : undefined}>{n.label}</a>)}
	</nav>
	<div class="edmi-header-end">
		<div class="edmi-search"><Search /></div>
		<FrameworkSelect />
		<div class="edmi-header-icons">
			<SocialIcons />
			<ThemeSelect />
		</div>
	</div>
</div>

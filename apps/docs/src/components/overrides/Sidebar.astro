---
// Section-isolated sidebar: only the section the current URL belongs to is rendered (Getting Started or
// Components), always expanded (no accordions). Pages outside those sections (landing, themes, examples,
// changelog) use the splash template and have no sidebar. Keeps Starlight's scroll persistence and mobile footer.
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import SidebarEntries from "./SidebarEntries.astro";

const { sidebar } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.slice(base.length);
const SECTIONS: Record<string, string> = {
	"/getting-started": "Getting Started",
	"/components": "Components",
};
const label = Object.entries(SECTIONS).find(([prefix]) => path.startsWith(prefix))?.[1];
const section = sidebar.find((e) => e.type === "group" && e.label === label);
const entries = section && section.type === "group" ? section.entries : [];
---

<SidebarPersister>
	<div class="edmi-side">
		<SidebarEntries entries={entries} />
	</div>
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

<script is:inline>
	// Collapsible categories: restore the user's open/closed choices (the one with the current page stays open).
	(function () {
		var K = "edmi-side", saved = {};
		try { saved = JSON.parse(localStorage.getItem(K) || "{}") || {}; } catch (e) {}
		var dets = document.querySelectorAll(".edmi-side details[data-key]");
		dets.forEach(function (d) {
			var k = d.getAttribute("data-key");
			if (!d.querySelector("a[aria-current='page']") && k in saved) d.open = !!saved[k];
			d.addEventListener("toggle", function () {
				try {
					var m = JSON.parse(localStorage.getItem(K) || "{}") || {};
					m[k] = d.open;
					localStorage.setItem(K, JSON.stringify(m));
				} catch (e) {}
			});
		});
	})();
</script>

<script>
	// Keep the current page visible inside the sidebar on load (nearest scrollable ancestor only).
	const cur = document.querySelector<HTMLElement>(".edmi-side a[aria-current='page']");
	let sc: HTMLElement | null = cur?.parentElement ?? null;
	while (sc && !(sc.scrollHeight > sc.clientHeight && /(auto|scroll)/.test(getComputedStyle(sc).overflowY)))
		sc = sc.parentElement;
	if (cur && sc && sc.clientHeight > 0) {
		const r = cur.getBoundingClientRect();
		const s = sc.getBoundingClientRect();
		if (r.top < s.top + 8 || r.bottom > s.bottom - 8)
			sc.scrollTop += r.top - s.top - s.height / 2 + r.height / 2;
	}
</script>

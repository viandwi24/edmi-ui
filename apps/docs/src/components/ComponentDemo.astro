---
import { Code } from "@astrojs/starlight/components";
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";
import { loadManifest } from "../lib/manifest";
import {
	CODE_LANG,
	DEMO_EXT,
	FRAMEWORK_LABEL,
	FRAMEWORKS,
	installCommand,
	type Framework,
} from "../config";
import OpenInStackBlitz from "./OpenInStackBlitz.astro";

interface Props {
	/** Registry item name, e.g. "button". */
	name: string;
	/** Demo file basename (default: `name`), e.g. "button-sizes". */
	demo?: string;
}
const { name, demo = name } = Astro.props;

const repoRoot = resolve(process.cwd(), "../..");
const docsRoot = process.cwd();
const item = (await loadManifest()).find((i) => i.name === name);

// Island modules (lazy: only the demos used on this page are loaded).
const loaders: Record<Framework, Record<string, () => Promise<any>>> = {
	react: import.meta.glob("./islands/react/*.astro"),
	vue: import.meta.glob("./islands/vue/*.astro"),
	svelte: import.meta.glob("./islands/svelte/*.astro"),
};

function rewriteImports(fw: Framework, src: string): string {
	switch (fw) {
		case "react":
			return src
				.replaceAll("@edmi-react/ui/", "@/components/ui/")
				.replaceAll("@edmi-react/hooks/", "@/hooks/")
				.replaceAll("@edmi-react/lib/", "@/lib/")
				.replaceAll("@edmi-react/blocks/", "@/components/");
		case "vue":
			return src
				.replaceAll("@edmi-vue/ui/", "@/components/ui/")
				.replaceAll("@edmi-vue/hooks/", "@/composables/")
				.replaceAll("@edmi-vue/lib/", "@/lib/")
				.replaceAll("@edmi-vue/blocks/", "@/components/");
		case "svelte":
			return src
				.replaceAll("@edmi-svelte/ui/", "$lib/components/ui/")
				.replaceAll("@edmi-svelte/hooks/", "$lib/hooks/")
				.replaceAll("@edmi-svelte/lib/", "$lib/")
				.replaceAll("@edmi-svelte/blocks/", "$lib/components/");
	}
}

type Panel = {
	fw: Framework;
	Demo: any;
	usage: string;
	sources: { path: string; code: string }[];
	install: string;
};
const panels: Panel[] = [];
for (const fw of FRAMEWORKS) {
	const entry = item?.frameworks[fw];
	if (item && (!entry || entry.skip)) continue;
	const rel = `src/demos/${fw}/${demo}.${DEMO_EXT[fw]}`;
	const abs = resolve(docsRoot, rel);
	const key = `./islands/${fw}/${demo}.astro`;
	if (!existsSync(abs) || !loaders[fw][key]) continue;
	const Demo = (await loaders[fw][key]()).default;
	const sources = (entry?.files ?? [])
		.filter((f) => !f.type || f.type !== "registry:file")
		.map((f) => {
			const p = resolve(repoRoot, "packages", fw, f.path);
			return { path: f.path, code: existsSync(p) ? readFileSync(p, "utf8") : "" };
		})
		.filter((s) => s.code);
	panels.push({
		fw,
		Demo,
		usage: rewriteImports(fw, readFileSync(abs, "utf8")),
		sources,
		install: installCommand(fw, name),
	});
}
---

{
	panels.length === 0 ? (
		<p class="edmi-demo-empty">
			<em>No live demo for this component yet.</em>
		</p>
	) : (
		<div class="edmi-demo not-content" data-edmi-demo>
			<div class="edmi-seg edmi-demo-fw" role="tablist" aria-label="Framework">
				{panels.map((p) => (
					<button type="button" role="tab" data-fw-tab={p.fw}>
						{FRAMEWORK_LABEL[p.fw]}
					</button>
				))}
			</div>
			{panels.map((p) => (
				<section class="edmi-demo-panel" data-fw-panel={p.fw} hidden>
					<div class="edmi-demo-card">
						<div class="edmi-demo-bar">
							<div class="edmi-seg" role="tablist" aria-label="View">
								<button type="button" role="tab" data-view-tab="preview">Preview</button>
								<button type="button" role="tab" data-view-tab="code">Code</button>
							</div>
							<div class="edmi-demo-tools">
								<button type="button" class="edmi-demo-tool" data-theme-switch aria-label="Toggle preview theme" title="Toggle preview theme">
									<svg data-sun viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
									<svg data-moon viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
									<span data-theme-switch-label>Light</span>
								</button>
								<OpenInStackBlitz framework={p.fw} />
							</div>
						</div>
						<div data-view="preview">
							<div class="edmi-preview edmi-preview-stage" data-preview-stage>
								<p.Demo />
							</div>
							<p class="edmi-icon-note">
								Icons are rewritten to your <code>iconLibrary</code> on install (Edmi default: Phosphor).
							</p>
						</div>
						<div data-view="code" hidden>
							<div class="edmi-code-tabs" role="tablist" aria-label="Code">
								<button type="button" role="tab" data-code-tab="usage">Usage</button>
								{p.sources.length > 0 && (
									<button type="button" role="tab" data-code-tab="source">Component source</button>
								)}
								<button type="button" role="tab" data-code-tab="install">Install</button>
							</div>
							<div data-code-panel="usage">
								<Code code={p.usage} lang={CODE_LANG[p.fw]} title={`${demo}.${DEMO_EXT[p.fw]}`} />
							</div>
							{p.sources.length > 0 && (
								<div data-code-panel="source" hidden>
									{p.sources.map((s) => (
										<Code code={s.code} lang={CODE_LANG[p.fw]} title={s.path} />
									))}
								</div>
							)}
							<div data-code-panel="install" hidden>
								<Code code={p.install} lang="bash" />
							</div>
						</div>
					</div>
				</section>
			))}
		</div>
	)
}

<style is:global>
	.edmi-demo { margin: 1.5rem 0 2rem; }
	/* flat segmented track: active = --tab-active fill + 1px border, no gradient, no lip (rule 5) */
	.edmi-seg { display: inline-flex; gap: 2px; padding: 3px; border-radius: 9px; background: var(--muted); border: 1px solid var(--border); }
	.edmi-seg button {
		font: 500 12.5px/1 var(--sl-font); padding: .4rem .75rem; border-radius: 6px; cursor: pointer;
		border: 1px solid transparent; background: transparent; color: var(--muted-foreground);
	}
	.edmi-seg button:hover { color: var(--foreground); }
	.edmi-seg button[aria-selected="true"] { background: var(--tab-active); border-color: var(--border); color: var(--foreground); }
	.edmi-demo-fw { margin-bottom: .75rem; }

	.edmi-demo-card { border: 1px solid var(--border); border-radius: 14px; overflow: hidden; background: var(--card); }
	.edmi-demo-bar {
		display: flex; justify-content: space-between; align-items: center; gap: .75rem; flex-wrap: wrap;
		padding: .5rem .625rem; border-bottom: 1px solid var(--border); background: var(--card);
	}
	.edmi-demo-bar .edmi-seg { padding: 2px; }
	.edmi-demo-bar .edmi-seg button { padding: .32rem .7rem; }
	.edmi-demo-tools { display: flex; align-items: center; gap: .25rem; }
	.edmi-demo-tool {
		display: inline-flex; align-items: center; gap: .375rem; height: 28px; padding: 0 .55rem; cursor: pointer;
		font: 500 11px/1 var(--sl-font-mono); text-transform: uppercase; letter-spacing: .05em;
		border-radius: 7px; border: 1px solid transparent; background: transparent; color: var(--muted-foreground);
	}
	.edmi-demo-tool:hover { background: var(--accent); color: var(--foreground); }
	.edmi-demo-tool [data-moon] { display: none; }
	.edmi-demo-tool[data-mode="dark"] [data-sun] { display: none; }
	.edmi-demo-tool[data-mode="dark"] [data-moon] { display: block; }

	.edmi-preview.edmi-preview-stage {
		position: relative; padding: 3rem 1.5rem; min-height: 14rem; display: flex; align-items: center; justify-content: center;
		overflow: auto; background-color: var(--stage);
		background-image: radial-gradient(color-mix(in oklab, var(--foreground) 16%, transparent) 1px, transparent 1.2px); background-size: 16px 16px;
	}
	.edmi-icon-note { margin: 0; padding: .5rem .875rem; font-size: .75rem; color: var(--muted-foreground); border-top: 1px solid var(--border); background: var(--card); }
	.edmi-icon-note code { font-size: .7rem; }

	.edmi-code-tabs { display: flex; gap: .125rem; align-items: center; flex-wrap: wrap; padding: .375rem .625rem 0; background: var(--card); border-bottom: 1px solid var(--border); }
	.edmi-code-tabs button {
		font: 500 12.5px/1 var(--sl-font); padding: .5rem .625rem .625rem; cursor: pointer; border: 0; background: transparent;
		color: var(--muted-foreground); border-bottom: 2px solid transparent; margin-bottom: -1px;
	}
	.edmi-code-tabs button:hover { color: var(--foreground); }
	.edmi-code-tabs button[aria-selected="true"] { color: var(--foreground); border-bottom-color: var(--foreground); }
	.edmi-demo-card .expressive-code { margin: 0; }
	.edmi-demo-card .expressive-code .frame { border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
	.edmi-demo-card .expressive-code .frame pre { border: 0 !important; border-radius: 0 !important; }
	.edmi-demo-card [data-code-panel] > .expressive-code + .expressive-code { border-top: 1px solid var(--border); }
	.edmi-demo-card .expressive-code .frame .header { border-radius: 0 !important; }
</style>

<script>
	const KEY = "edmi-framework";
	const demos = () => document.querySelectorAll<HTMLElement>("[data-edmi-demo]");
	let current: string | null = null;
	try { current = localStorage.getItem(KEY); } catch {}

	function applyFramework(fw: string) {
		current = fw;
		for (const demo of demos()) {
			const tabs = [...demo.querySelectorAll<HTMLElement>("[data-fw-tab]")];
			const has = tabs.some((t) => t.dataset.fwTab === fw);
			const active = has ? fw : tabs[0]?.dataset.fwTab;
			for (const t of tabs) t.setAttribute("aria-selected", String(t.dataset.fwTab === active));
			for (const p of demo.querySelectorAll<HTMLElement>("[data-fw-panel]")) p.hidden = p.dataset.fwPanel !== active;
		}
	}

	for (const demo of demos()) {
		for (const t of demo.querySelectorAll<HTMLElement>("[data-fw-tab]")) {
			t.addEventListener("click", () => {
				const fw = t.dataset.fwTab!;
				try { localStorage.setItem(KEY, fw); } catch {}
				applyFramework(fw);
				window.dispatchEvent(new CustomEvent(KEY, { detail: fw }));
			});
		}
		for (const panel of demo.querySelectorAll<HTMLElement>("[data-fw-panel]")) {
			// Preview | Code
			const views = [...panel.querySelectorAll<HTMLElement>("[data-view-tab]")];
			const showView = (id: string) => {
				for (const t of views) t.setAttribute("aria-selected", String(t.dataset.viewTab === id));
				for (const c of panel.querySelectorAll<HTMLElement>("[data-view]")) c.hidden = c.dataset.view !== id;
			};
			for (const t of views) t.addEventListener("click", () => showView(t.dataset.viewTab!));
			showView("preview");

			// Usage | Component source | Install
			const tabs = [...panel.querySelectorAll<HTMLElement>("[data-code-tab]")];
			const show = (id: string) => {
				for (const t of tabs) t.setAttribute("aria-selected", String(t.dataset.codeTab === id));
				for (const c of panel.querySelectorAll<HTMLElement>("[data-code-panel]")) c.hidden = c.dataset.codePanel !== id;
			};
			for (const t of tabs) t.addEventListener("click", () => show(t.dataset.codeTab!));
			show("usage");

			const stage = panel.querySelector<HTMLElement>("[data-preview-stage]")!;
			const sw = panel.querySelector<HTMLElement>("[data-theme-switch]")!;
			const label = panel.querySelector<HTMLElement>("[data-theme-switch-label]")!;
			let mode: "light" | "dark" = document.documentElement.classList.contains("dark") ? "dark" : "light";
			const paint = () => {
				stage.classList.toggle("dark", mode === "dark");
				stage.classList.toggle("edmi-light", mode === "light");
				label.textContent = mode === "dark" ? "Dark" : "Light";
				sw.dataset.mode = mode;
			};
			paint();
			sw.addEventListener("click", () => { mode = mode === "dark" ? "light" : "dark"; paint(); });
			// follow the site theme when it changes
			new MutationObserver(() => {
				mode = document.documentElement.classList.contains("dark") ? "dark" : "light";
				paint();
			}).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
		}
	}
	// Header select / install tabs / other demos announce a change with this event.
	window.addEventListener(KEY, (e) => applyFramework((e as CustomEvent<string>).detail));
	applyFramework(current ?? "react");
</script>

---
import { Code } from "@astrojs/starlight/components";
import { existsSync, readFileSync } from "node:fs";
import { loadManifest } from "../lib/manifest";
import { demoPath, rewriteImports } from "../lib/demo";
import {
	CODE_LANG,
	DEMO_EXT,
	FRAMEWORK_LABEL,
	FRAMEWORKS,
	type Framework,
} from "../config";
import OpenInStackBlitz from "./OpenInStackBlitz.astro";

interface Props {
	/** Registry item name, e.g. "button". */
	name: string;
	/** Demo file basename (default: `name`), e.g. "button-elevation". */
	demo?: string;
}
const { name, demo = name } = Astro.props;

const item = (await loadManifest()).find((i) => i.name === name);

// Island modules (lazy: only the demos used on this page are loaded).
const loaders: Record<Framework, Record<string, () => Promise<any>>> = {
	react: import.meta.glob("./islands/react/*.astro"),
	vue: import.meta.glob("./islands/vue/*.astro"),
	svelte: import.meta.glob("./islands/svelte/*.astro"),
};

type Panel = { fw: Framework; Demo: any; code: string };
const panels: Panel[] = [];
for (const fw of FRAMEWORKS) {
	const entry = item?.frameworks[fw];
	if (item && (!entry || entry.skip)) continue;
	const abs = demoPath(fw, demo);
	const key = `./islands/${fw}/${demo}.astro`;
	if (!existsSync(abs) || !loaders[fw][key]) continue;
	const Demo = (await loaders[fw][key]()).default;
	panels.push({ fw, Demo, code: rewriteImports(fw, readFileSync(abs, "utf8")) });
}
const has = panels.map((p) => p.fw);
const missing = FRAMEWORKS.filter((fw) => !has.includes(fw));
---

{
	panels.length === 0 ? (
		<p class="edmi-demo-empty">
			<em>No live demo for this component yet.</em>
		</p>
	) : (
		<div class="edmi-demo not-content" data-edmi-demo data-has={has.join(" ")}>
			<div class="edmi-demo-card">
				<div class="edmi-demo-bar">
					<div class="edmi-seg" role="tablist" aria-label="View">
						<button type="button" role="tab" data-view-tab="preview">Preview</button>
						<button type="button" role="tab" data-view-tab="code">Code</button>
					</div>
					<div class="edmi-demo-tools">
						<label class="edmi-fw-select edmi-fw-select-sm" title="Framework (shared across the site)">
							<span class="sr-only">Framework</span>
							<select data-framework-select aria-label="Framework">
								{FRAMEWORKS.map((fw) => <option value={fw}>{FRAMEWORK_LABEL[fw]}</option>)}
							</select>
							<svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
						</label>
						<button type="button" class="edmi-demo-tool" data-theme-switch aria-label="Toggle preview theme" title="Toggle preview theme">
							<svg data-sun viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
							<svg data-moon viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
							<span data-theme-switch-label>Light</span>
						</button>
						{panels.map((p) => (
							<span data-fw-panel={p.fw}><OpenInStackBlitz framework={p.fw} /></span>
						))}
					</div>
				</div>
				{missing.map((fw) => (
					<p class="edmi-fw-note" data-fw-note={fw}>
						Not available in {FRAMEWORK_LABEL[fw]} yet. Switch to{" "}
						{has.map((h, i) => (
							<>
								{i > 0 && " or "}
								<button type="button" data-fw-set={h}>{FRAMEWORK_LABEL[h]}</button>
							</>
						))}
						.
					</p>
				))}
				<div data-view="preview">
					{panels.map((p) => (
						<div data-fw-panel={p.fw}>
							<div class="edmi-preview edmi-preview-stage" data-preview-stage>
								<p.Demo />
							</div>
						</div>
					))}
				</div>
				<div data-view="code" hidden>
					{panels.map((p) => (
						<div data-fw-panel={p.fw}>
							<Code code={p.code} lang={CODE_LANG[p.fw]} title={`${demo}.${DEMO_EXT[p.fw]}`} />
						</div>
					))}
				</div>
			</div>
		</div>
	)
}

<style is:global>
	.edmi-demo { margin: 1.5rem 0 2rem; }
	/* flat segmented track: active = --tab-active fill + 1px border, no gradient, no bevel */
	.edmi-seg { display: inline-flex; gap: 2px; padding: 3px; border-radius: 9px; background: var(--muted); border: 1px solid var(--border); }
	.edmi-seg button {
		font: 500 12.5px/1 var(--sl-font); padding: .4rem .75rem; border-radius: 6px; cursor: pointer;
		border: 1px solid transparent; background: transparent; color: var(--muted-foreground);
	}
	.edmi-seg button:hover { color: var(--foreground); }
	.edmi-seg button[aria-selected="true"] { background: var(--tab-active); border-color: var(--border); color: var(--foreground); }

	.edmi-demo-card { border: 1px solid var(--border); border-radius: 14px; overflow: hidden; background: var(--card); }
	.edmi-demo-bar {
		display: flex; justify-content: space-between; align-items: center; gap: .75rem; flex-wrap: wrap;
		padding: .5rem .625rem; border-bottom: 1px solid var(--border); background: var(--card);
	}
	.edmi-demo-bar .edmi-seg { padding: 2px; }
	.edmi-demo-bar .edmi-seg button { padding: .32rem .7rem; }
	.edmi-demo-tools { display: flex; align-items: center; gap: .25rem; }
	.edmi-demo-tool {
		display: inline-flex; align-items: center; gap: .375rem; height: 28px; padding: 0 .55rem; cursor: pointer;
		font: 500 11px/1 var(--sl-font-mono); text-transform: uppercase; letter-spacing: .05em;
		border-radius: 7px; border: 1px solid transparent; background: transparent; color: var(--muted-foreground);
	}
	.edmi-demo-tool:hover { background: var(--accent); color: var(--foreground); }
	.edmi-demo-tool [data-moon] { display: none; }
	.edmi-demo-tool[data-mode="dark"] [data-sun] { display: none; }
	.edmi-demo-tool[data-mode="dark"] [data-moon] { display: block; }

	.edmi-preview.edmi-preview-stage {
		position: relative; padding: 3rem 1.5rem; min-height: 14rem; display: flex; align-items: center; justify-content: center;
		overflow: auto; background-color: var(--stage);
		background-image: radial-gradient(color-mix(in oklab, var(--foreground) 16%, transparent) 1px, transparent 1.2px); background-size: 16px 16px;
	}

	/* a navigation menu opens its panel below the trigger inside the stage: leave room so overflow does not clip it */
	.edmi-preview.edmi-preview-stage:has([data-slot="navigation-menu"]) { align-items: flex-start; min-height: 24rem; padding-top: 2rem; }

	.edmi-demo-card .expressive-code { margin: 0; }
	.edmi-demo-card .expressive-code .frame { border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
	.edmi-demo-card .expressive-code .frame pre { border: 0 !important; border-radius: 0 !important; }
	.edmi-demo-card .expressive-code .frame .header { border-radius: 0 !important; }

	.edmi-demo-tools .edmi-fw-select-sm { display: flex; }
	.edmi-demo-tools .edmi-fw-select-sm select { height: 28px; padding: 0 1.3rem 0 .5rem; font-size: 12px; border-radius: 7px; background: transparent; border-color: transparent; }
	.edmi-demo-tools .edmi-fw-select-sm select:hover { background: var(--accent); }
	.edmi-demo-tools .edmi-fw-select-sm svg { right: .45rem; }
	.edmi-fw-note { display: none; margin: 0; padding: 2.5rem 1.5rem; text-align: center; font-size: .8125rem; color: var(--muted-foreground); background: var(--stage); }
	.edmi-fw-note button { all: unset; cursor: pointer; font-weight: 500; color: var(--foreground); text-decoration: underline; text-underline-offset: 2px; }
</style>

<script>
	// Framework is global (header select -> localStorage "edmi-framework" + <html data-fw> + event).
	// Panel visibility is pure CSS on html[data-fw]; this only handles the view and theme toggles.
	for (const demo of document.querySelectorAll<HTMLElement>("[data-edmi-demo]")) {
		const views = [...demo.querySelectorAll<HTMLElement>("[data-view-tab]")];
		const showView = (id: string) => {
			for (const t of views) t.setAttribute("aria-selected", String(t.dataset.viewTab === id));
			for (const c of demo.querySelectorAll<HTMLElement>("[data-view]")) c.hidden = c.dataset.view !== id;
		};
		for (const t of views) t.addEventListener("click", () => showView(t.dataset.viewTab!));
		showView("preview");

		const stages = [...demo.querySelectorAll<HTMLElement>("[data-preview-stage]")];
		const sw = demo.querySelector<HTMLElement>("[data-theme-switch]")!;
		const label = demo.querySelector<HTMLElement>("[data-theme-switch-label]")!;
		let mode: "light" | "dark" = document.documentElement.classList.contains("dark") ? "dark" : "light";
		const paint = () => {
			for (const stage of stages) {
				stage.classList.toggle("dark", mode === "dark");
				stage.classList.toggle("edmi-light", mode === "light");
			}
			label.textContent = mode === "dark" ? "Dark" : "Light";
			sw.dataset.mode = mode;
		};
		paint();
		sw.addEventListener("click", () => { mode = mode === "dark" ? "light" : "dark"; paint(); });
		// follow the site theme when it changes
		new MutationObserver(() => {
			mode = document.documentElement.classList.contains("dark") ? "dark" : "light";
			paint();
		}).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
	}
</script>

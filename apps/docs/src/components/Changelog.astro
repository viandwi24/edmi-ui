---
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";

const root = resolve(process.cwd(), "../..");
const file = ["CHANGELOG.md", "packages/tokens/CHANGELOG.md"]
	.map((f) => resolve(root, f))
	.find((f) => existsSync(f));
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
const inline = (s: string) => esc(s).replace(/`([^`]+)`/g, "<code>$1</code>");
let html = "";
if (file) {
	let list = false;
	for (const line of readFileSync(file, "utf8").split("\n")) {
		const h = line.match(/^(#{1,4})\s+(.*)$/);
		const li = line.match(/^\s*[-*]\s+(.*)$/);
		if (list && !li) { html += "</ul>"; list = false; }
		if (h) html += `<h${Math.min(h[1].length + 1, 4)}>${inline(h[2])}</h${Math.min(h[1].length + 1, 4)}>`;
		else if (li) { if (!list) { html += "<ul>"; list = true; } html += `<li>${inline(li[1])}</li>`; }
		else if (line.trim()) html += `<p>${inline(line)}</p>`;
	}
	if (list) html += "</ul>";
}
---

{html ? <Fragment set:html={html} /> : <p>No releases yet. The changelog is generated by Changesets on release.</p>}

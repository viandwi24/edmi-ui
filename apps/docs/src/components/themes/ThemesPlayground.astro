---
import { loadThemeData } from "../../lib/theme-data";
import ThemeCustomizer from "./ThemeCustomizer";

const data = await loadThemeData();
---

<ThemeCustomizer client:load data={data} />

<style is:global>
	/* wide content, no right TOC: the preview grid needs the room */
	html:has(.edmi-themes) { --sl-content-width: 80rem; }
	.edmi-themes > * { margin-top: 0 !important; }
</style>

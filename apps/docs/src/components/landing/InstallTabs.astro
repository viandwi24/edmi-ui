---
import { BASE, EDMI_URL, FRAMEWORK_LABEL, FRAMEWORKS, installCommand, PMS } from "../../config";
void BASE;
void EDMI_URL;
---

<div class="edmi-install" data-install>
	<div class="edmi-install-tabs" role="tablist" aria-label="Framework">
		{FRAMEWORKS.map((fw) => <button type="button" role="tab" data-fw={fw}>{FRAMEWORK_LABEL[fw]}</button>)}
	</div>
	<div class="edmi-install-cmd">
		<span class="edmi-install-prompt" aria-hidden="true">$</span>
		{FRAMEWORKS.flatMap((fw) => PMS.map((pm) => <code data-cmd={fw} data-pm-panel={pm} hidden>{installCommand(fw, "button", pm)}</code>))}
		<button type="button" class="edmi-install-copy" data-copy aria-label="Copy command">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
		</button>
	</div>
	<div class="edmi-install-pm" role="group" aria-label="Package manager">
		{PMS.map((pm) => <button type="button" data-pm-set={pm}>{pm}</button>)}
	</div>
	<p class="edmi-install-all">
		Want everything? <a href={`${BASE}/getting-started/react/#install-everything`}>Install every component and pattern →</a>
	</p>
</div>

<script>
	const KEY = "edmi-framework";
	function init(root: HTMLElement) {
		const tabs = [...root.querySelectorAll<HTMLElement>("[data-fw]")];
		const cmds = [...root.querySelectorAll<HTMLElement>("[data-cmd]")];
		const show = (fw: string) => {
			for (const t of tabs) t.setAttribute("aria-selected", String(t.dataset.fw === fw));
			for (const c of cmds) c.hidden = c.dataset.cmd !== fw;
		};
		let cur = "react";
		try {
			cur = localStorage.getItem(KEY) ?? "react";
		} catch {}
		show(cur);
		for (const t of tabs) {
			t.addEventListener("click", () => {
				try {
					localStorage.setItem(KEY, t.dataset.fw!);
				} catch {}
				window.dispatchEvent(new CustomEvent(KEY, { detail: t.dataset.fw }));
			});
		}
		window.addEventListener(KEY, (e) => show((e as CustomEvent<string>).detail));
		root.querySelector("[data-copy]")?.addEventListener("click", (e) => {
			const text = cmds.find((c) => !c.hidden && getComputedStyle(c).display !== "none")?.textContent ?? "";
			navigator.clipboard?.writeText(text);
			const b = e.currentTarget as HTMLElement;
			b.dataset.done = "1";
			setTimeout(() => delete b.dataset.done, 1200);
		});
	}
	for (const r of document.querySelectorAll<HTMLElement>("[data-install]")) init(r);
</script>
